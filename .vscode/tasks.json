{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Publish website",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\publish-website.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Trim changed text files, clean-render, cache-version, publish, and verify the live GitHub Pages site."
    }
  ]
}
