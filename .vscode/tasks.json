{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Publish website",
      "type": "process",
      "command": "quarto",
      "args": [
        "run",
        "${workspaceFolder}/publish-website.ts"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Cross-platform clean-render, cache-version, publish, and live verification for Windows and Linux."
    }
  ]
}
